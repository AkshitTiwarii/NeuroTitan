---
import { CAMPUS_AMBASSADOR_FORM, NAV, SITE } from "../data/site";
import Mark from "./Mark.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer t-graphite">
  <div class="wrap cta">
    <p class="label label--red">Work with us</p>
    <p class="cta-line">Found an error in something we published, or want to build with us?</p>
    <a class="button" href={`mailto:${SITE.email}`}>Email the lab</a>
  </div>

  <div class="wrap grid">
    <div class="about">
      <a class="brand" href="/" aria-label="NeuroTitan Labs, home"><Mark size={28} /></a>
      <p class="name">NeuroTitan Labs</p>
      <p class="founder">Founded by {SITE.founder}</p>
      <p class="muted">Machine learning, semiconductors and quantum computing. Code and data with every result.</p>
    </div>
    <nav aria-label="Footer">
      <p class="label">Lab</p>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="label">Elsewhere</p>
      <ul>
        <li><a href={SITE.github} rel="noopener">GitHub</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href={CAMPUS_AMBASSADOR_FORM} rel="noopener">Campus ambassador</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap base">
    <p>© {year} NeuroTitan Labs · Founder: {SITE.founder}</p>
    <p><a href="/privacy">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
  }

  .cta {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(4rem, 9vw, 6.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .cta-line {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 4.2vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1.4fr;
    padding-block: 3.5rem 3rem;
  }

  .brand {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    margin-bottom: 0.4rem;
  }

  .founder {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin-bottom: 0.6rem;
  }

  .muted {
    font-size: 0.9375rem;
    max-width: 24rem;
    color: var(--grey);
  }

  .label {
    margin-bottom: 0.85rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.9375rem;
  }

  a {
    overflow-wrap: anywhere;
  }

  .base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--rule);
    padding-block: 1.25rem;
    font-size: 0.875rem;
    color: var(--grey);
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
