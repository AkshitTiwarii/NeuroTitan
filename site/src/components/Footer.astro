---
import { NAV, SITE } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">NeuroTitan Labs</p>
      <p class="muted">Machine learning, semiconductors and quantum computing. Code and data with every result.</p>
    </div>
    <nav aria-label="Footer">
      <p class="label">Site</p>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <div>
      <p class="label">Contact</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.github} rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap base">
    <p>© {year} NeuroTitan Labs</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-ink);
    padding-top: 3.5rem;
    margin-top: 0;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1.5fr;
    padding-bottom: 3rem;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
  }

  .muted,
  .base p {
    color: var(--footer-muted);
    font-size: 0.9375rem;
    max-width: 26rem;
  }

  .label {
    color: var(--footer-muted);
    margin-bottom: 0.75rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  a {
    text-decoration-color: var(--footer-rule);
    overflow-wrap: anywhere;
  }

  a:hover {
    color: var(--footer-red);
  }

  .base {
    border-top: 1px solid var(--footer-rule);
    padding-block: 1.25rem;
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
