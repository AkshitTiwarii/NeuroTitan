---
import { formatDate, type Post } from "../lib/posts";
import { readingMinutes } from "../lib/reading-time";

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ol class="posts">
  {
    posts.map((post) => (
      <li>
        <p class="meta label">
          <span class="field">{post.data.field}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.draft && <span class="draft">Draft</span>}
        </p>
        <h3>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
        </h3>
        <p class="desc">{post.data.description}</p>
        <p class="stats" data-stats-slug={post.id}>
          <span>{readingMinutes(post.body)} min read</span>
          <span data-stat="views" hidden />
          <span data-stat="avgread" hidden />
          <span data-stat="reactions" hidden />
        </p>
      </li>
    ))
  }
</ol>

<script>
  // Live view counts, reading time and reactions on each card (counters only).
  import "../scripts/post-stats";
</script>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .meta {
    display: flex;
    gap: 1rem;
  }

  .field {
    color: var(--red);
  }

  .draft {
    color: var(--ink);
    background: var(--red-soft);
    padding-inline: 0.4rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  h3 a {
    text-decoration: none;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--grey);
  }

  .stats > span:not([hidden]) + span:not([hidden])::before {
    content: "·";
    margin-inline: 0.5rem;
  }

  .desc {
    color: var(--ink-2);
    max-width: var(--measure);
  }
</style>
