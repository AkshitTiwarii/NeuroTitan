---
/**
 * The lab figure, small, in the opening of an inner page (right side, wide screens only).
 * shapes: which forms to show, "0" network, "1" chip, "2" sphere; "0,1,2" cycles through all three.
 * The page's opening section needs class="page-hero has-art".
 */
interface Props {
  shapes?: string;
}
const { shapes = "0,1,2" } = Astro.props;
---

<div class="page-art" aria-hidden="true">
  <canvas data-figure data-shapes={shapes}></canvas>
</div>

<script>
  import "../scripts/figure";
</script>

<style>
  .page-art {
    position: absolute;
    top: calc(50% + var(--header-h) / 2);
    right: calc((100% - min(100%, var(--wrap))) / 2 + var(--gutter));
    width: min(32vw, 28rem);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 72rem) {
    .page-art {
      display: none;
    }
  }
</style>
