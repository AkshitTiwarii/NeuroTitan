---
/**
 * Click-to-load 3D model from Sketchfab. Nothing from Sketchfab loads until the
 * visitor asks for it, so the page stays fast and no third party sees visitors
 * who do not interact. Same two models as the original /semiconductor page.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const src = `https://sketchfab.com/models/${id}/embed?autostart=1&ui_controls=1&ui_infos=0&ui_stop=0`;
---

<figure class="model" data-model={src} data-title={title}>
  <div class="frame">
    <button type="button" class="load">
      <span class="label label--red">3D model</span>
      <span class="t">{title}</span>
      <span class="button button--ghost">Load interactive model</span>
      <span class="note label">Loads from Sketchfab · drag to rotate, scroll to zoom</span>
    </button>
  </div>
  <figcaption class="label">{title} · via Sketchfab</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-model]").forEach((fig) => {
    const btn = fig.querySelector("button");
    btn?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = fig.dataset.model ?? "";
      iframe.title = fig.dataset.title ?? "3D model";
      iframe.allow = "autoplay; fullscreen; xr-spatial-tracking";
      iframe.setAttribute("allowfullscreen", "");
      fig.querySelector(".frame")?.replaceChildren(iframe);
    });
  });
</script>

<style>
  .model {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 18px 18px;
  }

  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .load {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.85rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
    font: inherit;
    padding: 1rem;
  }

  .t {
    font-family: var(--serif);
    font-size: 1.5rem;
    text-align: center;
  }

  .load:hover .button {
    color: var(--red);
    border-color: var(--red);
  }

  .note {
    font-size: 0.6875rem;
  }
</style>
