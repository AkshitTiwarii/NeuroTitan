---
/** A slow, looping strip of words. Pure CSS; stops under reduced motion. */
interface Props {
  items: readonly string[];
  label: string;
}
const { items, label } = Astro.props;
const loop = [...items, ...items];
---

<div class="ticker t-concrete" role="region" aria-label={label}>
  <ul class="visually-hidden">
    {items.map((i) => <li>{i}</li>)}
  </ul>
  <div class="track" aria-hidden="true">
    {
      loop.map((i) => (
        <span class="item">
          {i}
          <i />
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--rule);
    padding-block: 0.95rem;
  }

  .track {
    display: flex;
    width: max-content;
    animation: slide 55s linear infinite;
  }

  .ticker:hover .track {
    animation-play-state: paused;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .item i {
    width: 0.4rem;
    height: 0.4rem;
    background: var(--red);
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
