---
/**
 * Illustration of causal self-attention: each token looks back at earlier
 * tokens. Arc weights are drawn by hand to show the idea; they are NOT
 * measured from a model, and the caption says so.
 */
const tokens = ["The", " chip", " runs", " because", " it"];
// [from, to, weight]: "it" attends mostly to "chip"
const arcs: [number, number, number][] = [
  [4, 1, 0.9],
  [4, 0, 0.25],
  [4, 2, 0.35],
  [4, 3, 0.2],
  [2, 1, 0.6],
  [3, 2, 0.45],
];
const W = 560, gap = W / tokens.length, baseY = 150;
const x = (i: number) => gap * i + gap / 2;
---

<figure class="arcs">
  <svg viewBox={`0 0 ${W} 190`} role="img" aria-labelledby="arcs-title">
    <title id="arcs-title">Diagram: the token "it" attends most strongly to "chip"</title>
    {
      arcs.map(([a, b, wgt]) => {
        const x1 = x(a), x2 = x(b), mid = (x1 + x2) / 2, hgt = Math.abs(x1 - x2) * 0.55;
        return (
          <path
            class={a === 4 && b === 1 ? "arc arc--hot" : "arc"}
            d={`M ${x1} ${baseY - 22} Q ${mid} ${baseY - 22 - hgt} ${x2} ${baseY - 22}`}
            stroke-width={1 + wgt * 4}
            opacity={0.35 + wgt * 0.65}
          />
        );
      })
    }
    {
      tokens.map((t, i) => (
        <g>
          <rect class={i === 4 ? "tok tok--q" : "tok"} x={x(i) - 44} y={baseY - 18} width="88" height="34" />
          <text class="tok-text" x={x(i)} y={baseY + 4} text-anchor="middle">{t.replace(" ", "·")}</text>
        </g>
      ))
    }
  </svg>
  <figcaption class="label">Illustration · weights drawn by hand, not measured from a model</figcaption>
</figure>

<style>
  .arcs {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .arc {
    fill: none;
    stroke: var(--ink-2);
  }

  .arc--hot {
    stroke: var(--red);
  }

  .tok {
    fill: var(--paper-2);
    stroke: var(--rule);
  }

  .tok--q {
    stroke: var(--red);
  }

  .tok-text {
    font-family: var(--mono);
    font-size: 15px;
    fill: var(--ink);
  }
</style>
