---
/**
 * DEV ONLY. Lets gg compare the three candidate palettes on the real pages.
 * Rendered by Base.astro only when import.meta.env.DEV is true, so it never
 * reaches a production build. Delete this file once a palette is chosen.
 */
const palettes = [
  { id: "paper", name: "A · Paper", swatch: ["#f5f3ef", "#151515", "#a3211b"] },
  { id: "graphite", name: "B · Graphite", swatch: ["#0f0f0f", "#ece8e1", "#e5574e"] },
  { id: "concrete", name: "C · Concrete", swatch: ["#e7e8ea", "#0f1114", "#b8261c"] },
];
---

<div class="switcher" role="group" aria-label="Preview palette (development only)">
  <p>Palette preview</p>
  {
    palettes.map((p) => (
      <button type="button" data-set-palette={p.id}>
        <span class="sw">
          {p.swatch.map((c) => (
            <i data-color={c} />
          ))}
        </span>
        {p.name}
      </button>
    ))
  }
</div>

<script>
  const root = document.documentElement;
  const fromUrl = new URLSearchParams(location.search).get("palette");
  const initial = fromUrl ?? localStorage.getItem("nt-palette") ?? "paper";

  function apply(id: string) {
    root.dataset.palette = id;
    localStorage.setItem("nt-palette", id);
    document.querySelectorAll<HTMLButtonElement>("[data-set-palette]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.setPalette === id));
    });
  }

  document.querySelectorAll<HTMLElement>(".switcher i[data-color]").forEach((el) => {
    el.style.background = el.dataset.color ?? "";
  });
  document.querySelectorAll<HTMLButtonElement>("[data-set-palette]").forEach((b) => {
    b.addEventListener("click", () => apply(b.dataset.setPalette ?? "paper"));
  });
  apply(initial);
</script>

<style>
  .switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
    background: #ffffff;
    color: #151515;
    border: 1px solid #151515;
    font-family: var(--mono);
    font-size: 0.75rem;
    box-shadow: 4px 4px 0 #151515;
  }

  p {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #646464;
    margin-bottom: 0.25rem;
  }

  button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    text-align: left;
    padding: 0.35rem 0.5rem;
    border: 1px solid #d4d0c8;
    background: #ffffff;
    color: #151515;
    cursor: pointer;
  }

  button[aria-pressed="true"] {
    border-color: #151515;
    font-weight: 600;
  }

  .sw {
    display: inline-flex;
  }

  .sw i {
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid #999;
  }
</style>
