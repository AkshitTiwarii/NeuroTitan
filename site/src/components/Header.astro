---
import { NAV, SITE } from "../data/site";
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header t-graphite">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="NeuroTitan Labs, home">
      <Mark size={24} />
      <span class="brand-name">NeuroTitan<span class="brand-labs">Labs</span></span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="gh" href={SITE.github} rel="noopener">GitHub ↗</a>
    </nav>

    <details class="nav-mobile">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <nav aria-label="Main">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href={SITE.github} rel="noopener">GitHub ↗</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--rule);
    background: rgba(15, 15, 15, 0.92);
    backdrop-filter: blur(8px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-name {
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-labs {
    color: var(--grey);
    margin-left: 0.5em;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.5rem;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .gh {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    padding: 0.45rem 0.7rem;
  }

  .gh:hover {
    border-color: var(--red);
    text-decoration: none;
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 64rem) {
    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
    }

    summary {
      list-style: none;
      cursor: pointer;
      display: grid;
      gap: 6px;
      padding: 0.75rem 0.25rem;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--ink);
    }

    .nav-mobile[open] summary span:first-child {
      background: var(--red);
    }

    .nav-mobile nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 0.5rem var(--gutter) 1.25rem;
    }

    .nav-mobile ul {
      flex-direction: column;
      gap: 0;
    }

    .nav-mobile li a {
      display: block;
      padding: 0.8rem 0;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 26rem) {
    .brand-labs {
      display: none;
    }
  }
</style>
