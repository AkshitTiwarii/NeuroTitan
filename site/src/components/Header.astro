---
import { NAV, SITE } from "../data/site";
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!--
  Floating glass menu. The header strip is transparent and takes no clicks; only the pill does.
  The first section of every page slides up underneath it (see global.css, "Header space").
-->
<header class="site-header t-graphite">
  <div class="menu-wrap">
    <div class="menu-pill" data-header-pill>
      <a class="brand" href="/" aria-label="NeuroTitan Labs, home">
        <Mark size={24} />
        <span class="brand-name">NeuroTitan<span class="brand-labs">Labs</span></span>
      </a>

      <nav class="nav-desktop" aria-label="Main">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="gh" href={SITE.github} rel="noopener">GitHub <span aria-hidden="true">↗</span></a>

      <details class="nav-mobile">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <nav aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href={SITE.github} rel="noopener">GitHub ↗</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // The pill tightens and darkens a little once the page has scrolled.
  const pill = document.querySelector<HTMLElement>("[data-header-pill]");
  if (pill) {
    const set = () => pill.classList.toggle("is-scrolled", scrollY > 24);
    set();
    addEventListener("scroll", set, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: transparent;
    pointer-events: none;
  }

  .menu-wrap {
    max-width: calc(var(--wrap) + 1rem);
    margin-inline: auto;
    padding: 0.75rem clamp(0.6rem, 2vw, 1rem) 0;
  }

  .menu-pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.4rem 0.5rem 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(236, 232, 225, 0.1);
    background: rgba(18, 18, 18, 0.62);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
    transition: background-color 250ms ease, min-height 250ms ease;
  }

  .menu-pill.is-scrolled {
    background: rgba(14, 14, 14, 0.84);
    min-height: 3.2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .brand-name {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-labs {
    color: var(--grey);
    margin-left: 0.5em;
  }

  .nav-desktop ul {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    display: block;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-2);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .nav-desktop a:hover {
    color: var(--ink);
    background: rgba(236, 232, 225, 0.07);
  }

  .nav-desktop a[aria-current="page"] {
    color: var(--ink);
    background: rgba(229, 87, 78, 0.18);
  }

  .gh {
    flex: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    padding: 0.6rem 1rem;
    border-radius: 999px;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .gh:hover {
    color: var(--paper);
    background: #fff;
    transform: translateY(-1px);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 64rem) {
    .nav-desktop,
    .gh {
      display: none;
    }

    .nav-mobile {
      display: block;
    }

    summary {
      list-style: none;
      cursor: pointer;
      display: grid;
      place-content: center;
      gap: 6px;
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 999px;
      background: rgba(236, 232, 225, 0.08);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary span {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--ink);
      transition: transform 200ms ease;
    }

    .nav-mobile[open] summary span:first-child {
      transform: translateY(4px) rotate(45deg);
      background: var(--red);
    }

    .nav-mobile[open] summary span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .nav-mobile nav {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 0.5rem);
      border-radius: 1.25rem;
      border: 1px solid rgba(236, 232, 225, 0.1);
      /* Opaque on purpose: a blurred panel inside the blurred pill renders see-through in Chromium. */
      background: #131313;
      padding: 0.5rem 1.25rem 1rem;
      box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.6);
    }

    .nav-mobile ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-mobile li a {
      display: block;
      padding: 0.8rem 0;
      font-size: 1.05rem;
      text-decoration: none;
      color: var(--ink-2);
      border-bottom: 1px solid var(--rule);
    }

    .nav-mobile li:last-child a {
      border-bottom: 0;
    }

    .nav-mobile li a[aria-current="page"] {
      color: var(--red);
    }
  }

  @media (max-width: 26rem) {
    .brand-labs {
      display: none;
    }
  }
</style>
