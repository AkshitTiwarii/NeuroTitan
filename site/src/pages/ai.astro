---
import Base from "../layouts/Base.astro";
import TokenizerPlayground from "../components/TokenizerPlayground.astro";
import AttentionArcs from "../components/AttentionArcs.astro";
import { AI_DOMAINS } from "../data/site";

const steps = [
  {
    name: "Tokenize",
    body: "Text is cut into tokens from a fixed vocabulary, usually learned with byte-pair encoding. Each token becomes an integer ID. Common English words are often one token; rarer words and many non-Latin scripts break into several.",
    formula: '"read tokens" → [1293, 20290]  (o200k_base)',
  },
  {
    name: "Embed",
    body: "Each ID selects a row from a learned table: a vector of hundreds or thousands of numbers. Information about each token's position in the sequence is added, so order is not lost.",
    formula: "x_i = E[id_i] + position(i)",
  },
  {
    name: "Attend",
    body: "Every token builds a query, a key and a value. A token's output is a weighted mix of the values of earlier tokens, with weights from how well its query matches their keys. A causal mask stops it from looking ahead.",
    formula: "Attention(Q, K, V) = softmax(QKᵀ / √d) V",
  },
  {
    name: "Transform",
    body: "Attention is followed by a small feed-forward network. The pair forms one layer, wrapped in residual connections and normalisation. Models stack dozens of these layers.",
    formula: "h ← h + Attn(norm(h));  h ← h + MLP(norm(h))",
  },
  {
    name: "Predict",
    body: "The last vector is mapped to one score per vocabulary entry. Softmax turns scores into probabilities, one token is chosen, appended to the text, and the whole loop runs again.",
    formula: "p(next) = softmax(W · h_last)",
  },
];
---

<Base
  title="NeuroTitan AI"
  description="How a large language model works, step by step, with a live tokenizer you can try in English, Hindi and Odia. And what NeuroTitan Labs is building."
>
  <section class="hero t-graphite">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label label--red">NeuroTitan AI</p>
        <h1 class="display">Inside a language model.</h1>
        <p class="lede">
          A large language model does one thing: given some text, it scores every possible next token and picks one.
          Here is how that works, step by step, with a tokenizer you can try live, and what our lab is doing about it.
        </p>
        <div class="actions">
          <a class="button" href="#playground">Try the tokenizer</a>
          <a class="button button--ghost" href="#how">How it works</a>
        </div>
      </div>
      <div class="status card" data-reveal>
        <div class="console-bar"><i></i><i></i><i></i><span>neurotitan-ai · status</span></div>
        <dl>
          <div><dt class="label">Model released</dt><dd>None yet</dd></div>
          <div><dt class="label">Stage</dt><dd>Measurement and reproduction</dd></div>
          <div><dt class="label">Current questions</dt><dd>Tokenizer cost for Indian languages · quantization on laptops · how small models generalise</dd></div>
          <div><dt class="label">Release rule</dt><dd>Weights, training code, data card and evaluation harness ship together, or not at all</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section dots" id="how">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">How an LLM works</p>
          <h2>Five steps, repeated for every token</h2>
        </div>
        <p class="lede">
          This is the decoder-only transformer, the design behind most current language models. The attention step
          comes from Vaswani et al., <a href="https://arxiv.org/abs/1706.03762" rel="noopener">“Attention Is All You
          Need”</a>, 2017.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{s.name}</h3>
                <p>{s.body}</p>
              </div>
              <code>{s.formula}</code>
            </li>
          ))
        }
      </ol>
      <div class="attn card" data-reveal>
        <div>
          <p class="label label--red">Step 03, drawn</p>
          <h3>Attention lets “it” find “chip”</h3>
          <p class="muted">
            To predict what comes after “it”, the model needs to know what “it” refers to. Attention lets that token
            draw most of its information from “chip”, two positions back.
          </p>
        </div>
        <AttentionArcs />
      </div>
    </div>
  </section>

  <section class="section t-concrete">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">Step 01, live</p>
          <h2>Watch your text become tokens</h2>
        </div>
        <p class="lede">
          Type anything, or pick a language. Compare how many tokens the same sentence needs in English, Hindi and
          Odia: every extra token costs context space, time and money.
        </p>
      </div>
      <TokenizerPlayground />
    </div>
  </section>

  <section class="section t-graphite">
    <div class="wrap two-col">
      <div class="section-head" data-reveal>
        <p class="label">What we are building</p>
        <h2>Measure first, then build</h2>
      </div>
      <div class="build" data-reveal>
        <p class="lede">
          We have not released a model, and we will not announce one before it exists. Our AI work starts with
          questions a small lab can answer properly on ordinary hardware, each published with its code.
        </p>
        <ul class="qs">
          <li>
            <span class="label label--red">Q1</span>
            <span>How many more tokens do Odia, Hindi and Bengali cost than English across the tokenizers in use today?</span>
          </li>
          <li>
            <span class="label label--red">Q2</span>
            <span>How much accuracy do 4-bit and 8-bit quantized small models lose, and how much speed do they gain on a laptop CPU?</span>
          </li>
          <li>
            <span class="label label--red">Q3</span>
            <span>When does a small transformer stop memorising and start generalising, and what controls it?</span>
          </li>
        </ul>
        <p class="muted">Results will appear on the <a href="/blog">blog</a>, with repositories you can rerun.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="label">Domains</p>
        <h2>Six areas of AI we work across</h2>
      </div>
      <div class="domains">
        {
          AI_DOMAINS.map((d, i) => (
            <article data-reveal>
              <span class="label label--red">{String(i + 1).padStart(2, "0")}</span>
              <h3>{d.name}</h3>
              <p>{d.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 22px 22px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .hero-text {
    display: grid;
    gap: 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .status {
    background: var(--paper-2);
    border-color: var(--rule);
    box-shadow: 8px 8px 0 #000;
  }

  .status dl {
    margin: 0;
    padding: 0.5rem 1.25rem 1.25rem;
  }

  .status dl div {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .status dl div:last-child {
    border-bottom: 0;
  }

  .status dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }

  .status dl div:first-child dd {
    color: var(--red);
  }

  .lede a {
    color: var(--red);
  }

  .steps {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .num {
    font-family: var(--mono);
    font-size: 1.5rem;
    color: var(--red);
    line-height: 1.2;
  }

  .step h3 {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
  }

  .step p {
    color: var(--ink-2);
  }

  .step code {
    font-family: var(--mono);
    font-size: 0.875rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    padding: 0.6rem 0.8rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .attn {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .attn h3 {
    font-size: 1.6rem;
    margin-block: 0.5rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .build {
    display: grid;
    gap: 1.5rem;
  }

  .qs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .qs li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .build a {
    color: var(--red);
  }

  .domains {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--rule);
  }

  .domains article {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .domains h3 {
    font-size: 1.35rem;
  }

  .domains p {
    color: var(--ink-2);
    font-size: 0.975rem;
  }

  @media (max-width: 60rem) {
    .hero-grid,
    .two-col,
    .attn {
      grid-template-columns: 1fr;
    }

    .step {
      grid-template-columns: 2.5rem 1fr;
    }

    .step code {
      grid-column: 2;
    }

    .domains {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 36rem) {
    .domains {
      grid-template-columns: 1fr;
    }
  }
</style>
