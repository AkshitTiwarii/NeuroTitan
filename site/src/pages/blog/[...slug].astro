---
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts, type Post } from "../../lib/posts";
import { SITE } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, field, date, updated, authors, repo, image } = post.data;
const url = new URL(`/blog/${post.id}`, SITE.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: authors.map((name) =>
    name === SITE.name ? { "@type": "Organization", name, url: SITE.url } : { "@type": "Person", name },
  ),
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: url,
  ...(repo ? { codeRepository: repo } : {}),
  ...(image ? { image: new URL(image, SITE.url).href } : {}),
};
---

<Base title={title} description={description} image={image} type="article" jsonLd={jsonLd}>
  <article class="post">
    <header class="wrap post-head">
      <p class="label">
        <span class="label--red">{field}</span>
        <span aria-hidden="true"> · </span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              <span aria-hidden="true"> · </span>updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">
        By {authors.join(", ")}{!authors.includes(SITE.name) && ` with ${SITE.name}`}
        {
          repo && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={repo} rel="noopener">Code and data</a>
            </>
          )
        }
      </p>
    </header>

    <div class="wrap prose">
      <Content />
    </div>

    <footer class="wrap post-foot">
      <p>
        Found an error? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We correct posts and note what changed.
      </p>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    display: grid;
    gap: 1.1rem;
    max-width: calc(46rem + 2 * var(--gutter));
    padding-block: clamp(3rem, 8vw, 5rem) 2rem;
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
  }

  .byline {
    font-size: 0.9375rem;
    color: var(--grey);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  .byline a {
    color: var(--red);
  }

  .post-foot {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-block: 2rem 5rem;
    color: var(--grey);
    font-size: 0.9375rem;
  }

  /* Long-form text: serif body, mono for code and data. */
  .prose {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    font-family: var(--serif);
    font-size: 1.1875rem;
    line-height: 1.65;
  }

  .prose :global(> * + *) {
    margin-top: 1.15em;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.2em;
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: 1.8em;
  }

  .prose :global(a) {
    text-decoration-color: var(--red);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--paper-2);
    padding: 0.1em 0.3em;
  }

  .prose :global(pre) {
    font-size: 0.875rem;
    line-height: 1.55;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .prose :global(th) {
    border-bottom: 1px solid var(--ink);
    font-weight: 500;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    border-left: 2px solid var(--red);
    padding-left: 1rem;
    color: var(--ink-2);
  }

  /* Display equations scroll sideways on narrow screens instead of overflowing the page. */
  .prose :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25em;
  }

  .prose :global(.katex) {
    font-size: 1.05em;
  }

  .prose :global(img) {
    border: 1px solid var(--rule);
  }
</style>
