---
import Base from "../layouts/Base.astro";
import Ticker from "../components/Ticker.astro";
import PostList from "../components/PostList.astro";
import FieldIcon from "../components/FieldIcon.astro";
import { FIELDS, PILLARS, PRINCIPLES, PRODUCTS, SITE, TOOLS, CAMPUS_AMBASSADOR_FORM } from "../data/site";
import { getPublishedPosts } from "../lib/posts";
import { getOrgStats } from "../lib/github";
import titan from "../data/titan-nano.json";

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const stats = await getOrgStats();
const featured = PRODUCTS.slice(0, 4);
const sample = titan.samples[0];
const gainPct = ((1 - titan.test.int8.bpc / titan.baselines.test_bpc_best_order) * 100).toFixed(0);
const titanParams = (titan.params / 1e6).toFixed(1);
const published = allPosts.filter((p) => !p.data.draft).length;

// The word after "Research you can" cycles through these. The first one is what readers without
// JavaScript, screen readers and search engines get.
const words = ["rerun.", "check.", "measure.", "build on."];

// Captions under the hero figure, in the order the figure shows the fields.
const captions = [
  "01 · Machine learning: layers of a network, an activation passing through",
  "02 · Semiconductors: a die grid, a signal crossing it",
  "03 · Quantum computing: states on a Bloch sphere, one orbit precessing",
];

// The statement that lights up word by word. Words marked with * are drawn in red.
const statement =
  "A result is not *finished until someone other than its author has *rerun it from the published code and got the *same *numbers.".split(" ");

const numbers = [
  { label: "Public repositories", value: stats.publicRepos, src: `GitHub · ${SITE.githubOrg} · ${stats.fetchedAt}` },
  { label: "Posts published", value: published, src: "This site" },
  { label: "Research fields", value: FIELDS.length, src: "ML · semiconductors · quantum" },
  { label: "Products in progress", value: PRODUCTS.filter((p) => p.kind === "dev").length, src: "See products" },
];
---

<Base>
  <!-- 1. HERO: dark stage; text left, a figure that becomes each field on the right -->
  <section class="hero t-graphite">
    <div class="wrap hero-grid">
      <div class="hero-inner">
        <p class="eyebrow label"><span class="dash" aria-hidden="true"></span>NeuroTitan Labs · independent research</p>
        <h1 class="hero-title" aria-label={`Research you can ${words[0]}`}>
          <span aria-hidden="true">Research you can</span>
          <span class="swap" aria-hidden="true" data-words={JSON.stringify(words)}>{words[0]}</span>
        </h1>
        <p class="lede hero-lede">
          We work on machine learning, chip design and quantum computing. Every result ships with the code, data and
          random seeds that produced it, and we publish what did not work next to what did.
        </p>
        <div class="actions">
          <a class="btn btn--light" href="/ai">Explore NeuroTitan AI <span aria-hidden="true">→</span></a>
          <a class="btn btn--glass" href="/research">Research areas</a>
        </div>
      </div>
      <figure class="hero-figure" aria-hidden="true">
        <canvas data-figure></canvas>
        <figcaption class="label" data-figure-caption data-captions={JSON.stringify(captions)}>{captions[0]}</figcaption>
      </figure>
    </div>
    <div class="wrap facts">
      <div><strong>Code</strong><span>with every result</span></div>
      <div><strong>Data</strong><span>and the random seeds</span></div>
      <div><strong>Failures</strong><span>published next to successes</span></div>
    </div>
  </section>

  <Ticker items={TOOLS} label="Tools we use" />

  <!-- 2. STATEMENT: the lab's rule, lit word by word as you scroll -->
  <section class="statement t-graphite" data-statement>
    <div class="statement-stage">
      <div class="wrap">
        <p class="label statement-kicker">The standard</p>
        <p class="statement-text">
          {
            statement.map((w) => (
              <>
                <span class:list={["w", { red: w.startsWith("*") }]}>{w.replace("*", "")}</span>{" "}
              </>
            ))
          }
        </p>
      </div>
    </div>
  </section>

  <!-- 3. FIELDS: numbered rows with moving line drawings -->
  <section class="section fields-sec">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">01 · Fields</p>
          <h2>What we work on</h2>
        </div>
        <p class="lede">
          A result is not finished until someone other than its author has rerun it from the published code and got
          the same numbers.
        </p>
      </div>
      <ol class="rows">
        {
          FIELDS.map((f) => (
            <li class="row" data-reveal>
              <a href={f.href}>
                <span class="row-num label">{f.index}</span>
                <div class="row-text">
                  <h3>{f.name}</h3>
                  <p>{f.summary}</p>
                  <ul class="chips" aria-label="Tools">
                    {f.tools.slice(0, 4).map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
                <div class="row-art">
                  <FieldIcon id={f.id} />
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. AI: graphite with a console -->
  <section class="section t-graphite ai">
    <div class="ai-glow" aria-hidden="true"></div>
    <div class="wrap ai-grid">
      <div data-reveal>
        <p class="label">02 · NeuroTitan AI</p>
        <h2>Titan-nano: our first model, built from scratch</h2>
        <p class="lede">
          A {titanParams}-million-parameter transformer we designed and trained in-house on Python code. On code it never
          saw, it needs {gainPct}% fewer bits per character than the best classical model. It runs in your browser on our
          own inference engine, and you can watch its real attention as it writes.
        </p>
        <div class="actions">
          <a class="btn btn--light" href="/ai#demo">Try Titan-nano <span aria-hidden="true">→</span></a>
          <a class="btn btn--glass" href="/ai#results">See the results</a>
        </div>
      </div>
      <div class="console" data-reveal aria-label="A real completion from Titan-nano">
        <div class="console-bar"><i></i><i></i><i></i><span>titan-nano · unedited sample · temperature {sample.temperature} · seed {sample.seed}</span></div>
        <pre class="console-body sample"><span class="prompt-text">{sample.prompt}</span><span class="gen">{sample.completion}</span></pre>
      </div>
    </div>
  </section>

  <!-- 5. PRODUCTS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">03 · Products</p>
          <h2>What we are building</h2>
        </div>
        <p class="lede">Each one is labelled with where it really stands.</p>
      </div>
      <div class="products">
        {
          featured.map((p) => (
            <article class="product" data-reveal>
              <header>
                <h3>{p.name}</h3>
                <span class={`pill pill--${p.kind}`}>{p.status}</span>
              </header>
              <p>{p.summary}</p>
              <p class="links">
                {p.links.map((l) => (
                  <a href={l.href} rel={l.href.startsWith("http") ? "noopener" : undefined}>
                    {l.label} →
                  </a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
      <p class="all"><a href="/products">All products →</a></p>
    </div>
  </section>

  <!-- 6. NUMBERS: computed at build time, count up on screen -->
  <section class="section t-concrete">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">04 · The lab in numbers</p>
          <h2>Counted, not claimed</h2>
        </div>
        <p class="lede">
          Computed when the site is built, from GitHub and from this site's own content. Nothing here is typed in by
          hand.
        </p>
      </div>
      <dl class="big-numbers" data-reveal>
        {
          numbers.map((n) => (
            <div>
              <dt>{n.label}</dt>
              <dd class="big" data-count={n.value ?? undefined}>{n.value ?? "—"}</dd>
              <dd class="src">{n.src}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 7. BLOG -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">05 · Blog</p>
          <h2>From the lab notebook</h2>
        </div>
        <p class="lede">Two posts a week when they are ready. A post that is not ready waits.</p>
      </div>
      {
        posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <p class="muted">The first posts are being run and checked now.</p>
        )
      }
    </div>
  </section>

  <!-- 8. HOW WE WORK -->
  <section class="section dots">
    <div class="wrap two-col">
      <div class="section-head" data-reveal>
        <p class="label">06 · How we work</p>
        <h2>The rules every result follows</h2>
      </div>
      <ol class="principles" data-reveal>
        {
          [...PRINCIPLES, ...PILLARS].slice(0, 6).map((p, i) => (
            <li>
              <span class="p-num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. JOIN -->
  <section class="section join-sec">
    <div class="wrap join-grid">
      <div class="join-head" data-reveal>
        <p class="label label--red">07 · Join the lab</p>
        <h2>Rerun our work.<br /><span class="soft">Or build the next one with us.</span></h2>
      </div>
      <ul class="join-links" data-reveal>
        <li>
          <a href={SITE.github} rel="noopener">
            <span class="label">GitHub</span>
            <span class="jl-text">Every repository is public. Issues and pull requests welcome.</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={CAMPUS_AMBASSADOR_FORM} rel="noopener">
            <span class="label">Campus ambassadors</span>
            <span class="jl-text">Represent the lab and run sessions at your college.</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`}>
            <span class="label">Corrections</span>
            <span class="jl-text">Found an error? {SITE.email}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import "../scripts/home";
</script>

<style>
  /* ---------- shared ---------- */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn--light {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 8px 24px -10px rgba(229, 87, 78, 0.55);
  }

  .btn--light:hover {
    color: var(--paper);
    background: #fff;
  }

  .btn--glass {
    color: var(--ink);
    border: 1px solid rgba(236, 232, 225, 0.22);
    background: rgba(236, 232, 225, 0.06);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .btn--glass:hover {
    color: var(--ink);
    border-color: var(--red);
  }

  /* ---------- 1. hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    background:
      radial-gradient(60rem 40rem at 78% 45%, rgba(229, 87, 78, 0.07), transparent 60%),
      var(--paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    width: 100%;
    padding-block: clamp(2.5rem, 7vh, 5rem) 2rem;
  }

  .hero-inner {
    display: grid;
    gap: 1.6rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dash {
    width: 2.5rem;
    height: 1px;
    background: var(--red);
  }

  .hero-title {
    display: grid;
    font-size: clamp(3rem, 7.4vw, 6.75rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .swap {
    color: var(--red);
    font-style: italic;
    min-height: 1em;
    white-space: nowrap;
  }

  .hero-lede {
    max-width: 34rem;
  }

  .hero-figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }

  .hero-figure canvas {
    width: 100%;
    aspect-ratio: 1;
    max-width: 38rem;
  }

  .hero-figure figcaption {
    min-height: 2.6em;
    max-width: 30rem;
    text-align: center;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .hero-figure figcaption.is-in {
    animation: cap-in 600ms ease both;
  }

  @keyframes cap-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
    padding-block: 1.5rem 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .facts div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .facts strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
  }

  .facts span {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--grey);
  }

  /* ---------- 2. statement ----------
     Without JS (or with reduced motion) the text is simply shown in full. With JS the section is
     taller and its stage sticks while the words light up. */
  .statement {
    border-top: 1px solid var(--rule);
  }

  .statement-stage {
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 14vh, 9rem);
  }

  .statement.is-live {
    height: 240vh;
  }

  .statement.is-live .statement-stage {
    position: sticky;
    top: 0;
    min-height: 100svh;
    padding-block: var(--header-h) 2rem;
  }

  .statement-kicker {
    margin-bottom: 1.75rem;
  }

  .statement-text {
    font-family: var(--serif);
    font-size: clamp(2rem, 5.2vw, 4.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 22ch;
    text-wrap: balance;
  }

  .w {
    transition: color 350ms ease;
  }

  .statement.is-live .w {
    color: rgba(236, 232, 225, 0.16);
  }

  .statement.is-live .w.on {
    color: var(--ink);
  }

  .w.red,
  .statement.is-live .w.red.on {
    color: var(--red);
    font-style: italic;
  }

  /* ---------- 3. field rows ---------- */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .row a {
    display: grid;
    grid-template-columns: 4rem 1fr 11rem;
    gap: 1.5rem 2rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border-radius: 1.5rem;
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    color: var(--ink);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
  }

  .row a:hover {
    color: var(--ink);
    transform: translateY(-3px);
    border-color: var(--ink);
    background: #fff;
    box-shadow: 0 18px 40px -24px rgba(21, 21, 21, 0.35);
  }

  .row-num {
    align-self: start;
    padding-top: 0.6rem;
  }

  .row-text {
    display: grid;
    gap: 0.75rem;
  }

  .row h3 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .row p {
    color: var(--ink-2);
    max-width: 44rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .chips li {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .row-art {
    color: var(--ink);
  }

  /* ---------- 4. AI ---------- */
  .ai {
    position: relative;
    overflow: hidden;
  }

  .ai-glow {
    position: absolute;
    width: 40rem;
    height: 40rem;
    right: -12rem;
    top: -14rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 87, 78, 0.18), transparent 65%);
    pointer-events: none;
  }

  .ai-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .ai h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    margin-block: 0.85rem 1.25rem;
  }

  .ai .lede {
    margin-bottom: 1.75rem;
  }

  .ai .console {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(236, 232, 225, 0.06);
  }

  .console-bar i {
    border-radius: 50%;
  }

  .sample {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 9rem;
  }

  .sample .prompt-text {
    color: var(--ink);
  }

  .sample .gen {
    color: var(--red);
  }

  /* ---------- 5. products ---------- */
  .products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .product {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.45);
    transition: transform 220ms ease, border-color 220ms ease, background-color 220ms ease;
  }

  .product:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
    background: #fff;
  }

  .product header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .product h3 {
    font-size: 1.6rem;
  }

  .product p {
    color: var(--ink-2);
  }

  .product .pill {
    border-radius: 999px;
  }

  .product .pill::before {
    border-radius: 50%;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .links a,
  .all a {
    color: var(--red);
    text-decoration: none;
  }

  .all {
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 0.875rem;
  }

  /* ---------- 6. numbers ---------- */
  .big-numbers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .big-numbers > div {
    display: grid;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem 1.5rem 0;
  }

  .big-numbers > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }

  .big {
    order: -1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .big-numbers > div:first-child .big {
    color: var(--red);
  }

  .big-numbers dt {
    font-weight: 500;
  }

  .src {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--grey);
  }

  /* ---------- 8. principles ---------- */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .principles li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.4rem;
    border-radius: 1.25rem;
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .p-num {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .principles h3 {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: 0.35rem;
  }

  .principles p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* ---------- 9. join ---------- */
  .join-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .join-head {
    display: grid;
    gap: 1.25rem;
  }

  .join-head h2 {
    font-size: clamp(2.1rem, 4.4vw, 3.5rem);
  }

  .soft {
    color: var(--grey);
  }

  .join-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .join-links a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "label arrow"
      "text arrow";
    gap: 0.35rem 1.5rem;
    align-items: center;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
