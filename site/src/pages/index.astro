---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { FIELDS, PRINCIPLES, PROJECTS } from "../data/site";
import { getPublishedPosts } from "../lib/posts";

const posts = (await getPublishedPosts()).slice(0, 3);

const steps = [
  ["Question", "A specific claim we can test, with the paper or datasheet it comes from."],
  ["Experiment", "Seeded code, pinned versions, raw logs kept."],
  ["Rerun", "A second person reruns it from the README. Numbers must match."],
  ["Publish", "Post, code and data go out together, limits stated."],
];
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label label--red">Independent research lab</p>
      <h1>Research you can rerun.</h1>
      <p class="lede">
        NeuroTitan Labs works on machine learning, semiconductor design and quantum computing. Every result we
        publish ships with the code, data and random seeds that produced it, and we report what did not work
        next to what did.
      </p>
      <div class="actions">
        <a class="button" href="/research">Research areas</a>
        <a class="button button--ghost" href="/blog">Read the blog</a>
      </div>
    </div>

    <figure class="method" aria-labelledby="method-caption">
      <figcaption id="method-caption" class="label">How a result gets published</figcaption>
      <ol>
        {
          steps.map(([name, text], i) => (
            <li>
              <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="step-body">
                <strong>{name}</strong>
                <span>{text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </figure>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Fields</p>
        <h2>Three fields, one standard of evidence</h2>
      </div>
      <div class="fields">
        {
          FIELDS.map((f) => (
            <article class="field">
              <p class="label label--red">{f.index}</p>
              <h3>
                <a href={`/research#${f.id}`}>{f.name}</a>
              </h3>
              <p>{f.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Writing</p>
        <h2>From the blog</h2>
      </div>
      {
        posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <p class="lede empty">
            Nothing published yet. The first posts are being run and checked now. Each one will link to a public
            repository you can rerun. <a href="/rss.xml">Follow by RSS</a>.
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="label">Standards</p>
        <h2>How we work</h2>
      </div>
      <dl class="principles">
        {
          PRINCIPLES.map((p) => (
            <div>
              <dt>{p.title}</dt>
              <dd>{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="label">Open work</p>
        <h2>What you can open today</h2>
      </div>
      <ul class="projects">
        {
          PROJECTS.map((p) => (
            <li>
              <a href={p.href} rel="noopener">
                {p.name}
                <span aria-hidden="true"> ↗</span>
              </a>
              <p>{p.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-block: clamp(3.5rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }

  .hero-text {
    display: grid;
    gap: 1.5rem;
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 450;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .method {
    margin: 0;
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .method ol {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .method li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .step-num {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--red);
    padding-top: 0.15rem;
  }

  .step-body {
    display: grid;
    gap: 0.15rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .step-body strong {
    font-weight: 600;
    color: var(--ink);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
  }

  .field {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 0 0;
  }

  .field + .field {
    border-left: 1px solid var(--rule);
    padding-left: 1.5rem;
  }

  .field h3 {
    font-size: 1.625rem;
  }

  .field h3 a {
    text-decoration: none;
  }

  .field p:last-child {
    color: var(--ink-2);
  }

  .empty a {
    color: var(--red);
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 2.5rem;
    margin: 0;
  }

  .principles dt {
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .principles dd {
    margin: 0;
    color: var(--ink-2);
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .projects li {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .projects a {
    font-weight: 600;
    text-decoration: none;
  }

  .projects p {
    color: var(--ink-2);
  }

  @media (max-width: 56rem) {
    .hero,
    .two-col {
      grid-template-columns: 1fr;
    }

    .fields {
      grid-template-columns: 1fr;
    }

    .field,
    .field + .field {
      border-left: 0;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .projects li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
